{{- /* ===========================
     AUTHOR HANDLING
     =========================== */ -}}
{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}{{ $authorEmail = . }}{{ end }}
  {{- end }}
{{- else }}
  {{- with site.Author.email }}
    {{- warnf "Deprecated: use params.author.email." }}
    {{- $authorEmail = . }}
  {{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}{{ $authorName = . }}{{ end }}
  {{- else }}
    {{- $authorName = . }}
  {{- end }}
{{- else }}
  {{- with site.Author.name }}
    {{- warnf "Deprecated: use params.author.name." }}
    {{- $authorName = . }}
  {{- end }}
{{- end }}


{{- /* ===========================
     CONTEXT + PAGES
     =========================== */ -}}
{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = site }}{{ end }}

{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
  {{- $pages = $pctx.RegularPages }}
{{- else }}
  {{- $pages = $pctx.Pages }}
{{- end }}

{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $pages = $pages | first $limit }}
{{- end }}


{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:media="http://search.yahoo.com/mrss/">

  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ .Title }} on {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content on {{ site.Title }}</description>

    {{- with site.Params.images }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ index . 0 | absURL }}</url>
      <link>{{ index . 0 | absURL }}</link>
    </image>
    {{- end }}

    <generator>Hugo — {{ hugo.Version }}</generator>
    <language>{{ site.Language.LanguageCode }}</language>

    {{- with $authorEmail }}
    <managingEditor>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>
    {{- end }}

    {{- with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>
    {{- end }}

    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}

    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType }}" />
    {{- end }}


    {{- /* ===========================
         ITEMS LOOP
         =========================== */ -}}
    {{- range $pages }}
    {{- if and (ne .Layout "search") (ne .Layout "archives") }}

    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>

      {{- with $authorEmail }}
      <author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>
      {{- end }}

      <guid isPermaLink="true">{{ .Permalink }}</guid>

      <!-- ===========================
           DESCRIPTION
           =========================== -->
      <description>
        {{- $text := "" }}

        {{- /* priority — front matter description */ -}}
        {{- with .Params.description }}
          {{- $text = . }}
        {{- else }}
          {{- if .Description }}
            {{- $text = .Description }}
          {{- else if .Summary }}
            {{- $text = .Summary }}
          {{- else }}
            {{- $text = .Content }}
          {{- end }}
        {{- end }}

        {{- $clean := replaceRE "^# .*?\n" "" $text }}
        {{- $clean = replaceRE "^<h1[^>]*>.*?</h1>" "" $clean }}

        {{- $plain := $clean | plainify }}
        {{- $plain = trim $plain " \n\r\t" }}

        {{/* ===========================
             HARD REMOVE TITLE IF IT IS AT BEGINNING
           =========================== */}}
        {{- $plainTitle := trim (.Title | plainify) " \n\r\t" }}
        {{- $titleWithSpace := printf "%s " $plainTitle }}

        {{- if hasPrefix $plain $titleWithSpace }}
          {{- $plain = substr $plain (len $titleWithSpace) }}
        {{- end }}

        {{- $plain = trim $plain " \n\r\t" }}

        {{- $plain | truncate 220 | html }}
      </description>


      {{/* ===========================
           SAFE SLUG DETECTION
           =========================== */}}
      {{- $slug := "" }}
      {{- with .File }}
        {{- $slug = path.Base .BaseFileName }}
      {{- end }}

      {{- if ne $slug "" }}

      <media:group>

        <!-- BRAND IMAGE -->
        <media:content
            url="{{ "/images/brand/26.webp" | absURL }}"
            medium="image" />
        <media:thumbnail
            url="{{ "/images/brand/26.webp" | absURL }}" />

        {{/* ===========================
             CARD URLS
             =========================== */}}
        {{- $fb := "" }}
        {{- $ig := "" }}
        {{- $pin := "" }}

        {{- with .Params.cards }}
          {{- with .facebook }}  {{ $fb = . }} {{ end }}
          {{- with .instagram }} {{ $ig = . }} {{ end }}
          {{- with .pinterest }} {{ $pin = . }} {{ end }}
        {{- end }}

        <media:content url="{{ $fb }}" medium="image" />
        <media:thumbnail url="{{ $fb }}" />
        <enclosure url="{{ $fb }}" type="image/jpeg" />

        <media:content url="{{ $ig }}" medium="image" />
        <media:thumbnail url="{{ $ig }}" />
        <enclosure url="{{ $ig }}" type="image/jpeg" />

        <media:content url="{{ $pin }}" medium="image" />
        <media:thumbnail url="{{ $pin }}" />
        <enclosure url="{{ $pin }}" type="image/jpeg" />

      </media:group>

      {{- end }}

      {{- if and site.Params.ShowFullTextinRSS .Content }}
      <content:encoded><![CDATA[{{ .Content }}]]></content:encoded>
      {{- end }}

    </item>

    {{- end }}
    {{- end }}

  </channel>
</rss>
